[project]
name = "{{ repo }}"
version = "0.0.0"
description = ""
readme = "README.md"
requires-python = ">={{ python_floor }}"
# The Python classifiers and the test matrix in `ci.yml` list the same versions.
classifiers = [
  "Programming Language :: Python :: 3",
{% for v in python_versions %}
  "Programming Language :: Python :: {{ v }}",
{% endfor %}
  "Typing :: Typed",
]
dependencies = []

# PyPI's sidebar shows these links, and the Changelog one points at the GitHub releases page.
[project.urls]
Changelog = "https://github.com/{{ owner }}/{{ repo }}/releases"
{% if docs %}
Documentation = "https://{{ owner }}.github.io/{{ repo }}/"
{% endif %}
Homepage = "https://github.com/{{ owner }}/{{ repo }}"
Issues = "https://github.com/{{ owner }}/{{ repo }}/issues"
Source = "https://github.com/{{ owner }}/{{ repo }}"

[dependency-groups]
# The tools have no lower bound, because `uv.lock` pins each one and an upgrade moves it to the latest release.
dev = [
  "coverage",
{% if framework == "dagster" %}
  "dagster-dg-cli",
  "dagster-webserver",
{% elif framework == "fastapi" %}
  "httpx",
{% endif %}
  "prek",
  "pytest",
  "ruff",
  "ty",
]
{% if docs %}
# Not in `dev`, so the test and lint jobs skip Quarto's Jupyter stack.
docs = ["great-docs>=0.17"]
{% endif %}

[build-system]
requires = ["uv_build>=0.13.7,<0.14.0"]
build-backend = "uv_build"

[tool.coverage.run]
source_pkgs = ["{{ package }}"]

[tool.coverage.report]
# Every other exclusion is a `# pragma: no cover` that a reviewer sees.
exclude_also = ["if TYPE_CHECKING:"]
fail_under = 100
show_missing = true

[tool.pytest.ini_options]
# importlib mode imports the package from the installed wheel, not from src/. tests/ needs no __init__.py.
addopts = ["--strict-config", "--strict-markers", "--import-mode=importlib", "-ra"]
# A new upstream deprecation fails the Dependabot PR that brings it in, before the removal breaks the package.
filterwarnings = ["error"]
{% if framework == "fastapi" %}
# anyio runs each async test on the backend the marker names.
markers = ["anyio"]
{% endif %}
{% if framework == "dagster" %}
# The tests import the project module from the working tree.
pythonpath = ["."]
{% endif %}
testpaths = ["tests"]
xfail_strict = true

[tool.typos.default.extend-identifiers]
# The ruff rule for flake8-copyright.
CPY001 = "CPY001"
