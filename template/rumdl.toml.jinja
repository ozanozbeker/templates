[global]
enable = ["ALL"]
disable = [
  "MD024",  # Multiple headings with the same content
  "MD063",  # Heading text capitalization style
  "MD082",  # No content before the next heading
]
exclude = [
  # A skill writes these files in its own shape, not one sentence per line.
  "docs/agents/",
{% if pypi %}
  # release-please writes the changelog.
  "CHANGELOG.md",
{% endif %}
]
{% if python %}
# `quarto` enables MD078, which requires a label on every executable chunk.
flavor = "quarto"
{% endif %}
respect-gitignore = true

# One sentence per line, so a diff shows the sentence that changed.
[MD013]
line-length = 0
code-blocks = false
reflow = true
reflow-mode = "sentence-per-line"

[MD093]
code = false
