# Ruff reads the target version from `requires-python`, and formats a `.qmd` page as markdown.
extension = { qmd = "markdown" }

[lint]
select = ["ALL"]
ignore = [
  # The top-level LICENSE covers every file, so no file carries a copyright header.
  "CPY001",  # flake8-copyright

  # Ruff recommends disabling these rules alongside its formatter: https://docs.astral.sh/ruff/formatter/#conflicting-lint-rules
  "COM812",  # flake8-commas > missing-trailing-comma
  "COM819",  # flake8-commas > prohibited-trailing-comma
  "D203",  # pydocstyle > incorrect-blank-line-before-class
  "D206",  # pydocstyle > docstring-tab-indentation
  "D300",  # pydocstyle > triple-single-quotes
  "E111",  # pycodestyle Error > indentation-with-invalid-multiple
  "E114",  # pycodestyle Error > indentation-with-invalid-multiple-comment
  "E117",  # pycodestyle Error > over-indented
  "E501",  # pycodestyle Error > line-too-long
  "ISC002",  # flake8-implicit-str-concat > multi-line-implicit-string-concatenation
  "Q",  # flake8-quotes
  "W191",  # pycodestyle Warning > tab-indentation
{% if framework == "fastapi" %}

  # `Depends()` and `Query()` in a parameter default are how FastAPI declares dependencies.
  "B008",  # flake8-bugbear > function-call-in-default-argument
{% endif %}
]
unfixable = [
  "F401",  # Pyflakes > unused-import
  "T20",  # flake8-print > ALL
]

[lint.per-file-ignores]
"**/__init__.py" = [
  "D104",  # pydocstyle > undocumented-public-package
  "F401",  # Pyflakes > unused-import
]

"**/tests/**/*.py" = [
  # Not `ANN001`, because ty does not report an unannotated parameter.
  "ANN201",  # flake8-annotations > missing-return-type-undocumented-public-function
  "ANN202",  # flake8-annotations > missing-return-type-private-function
  "ANN401",  # flake8-annotations > any-type
  "ARG001",  # flake8-unused-arguments > unused-function-argument
  "D",  # pydocstyle > ALL
  "FBT001",  # flake8-boolean-trap > boolean-type-hint-positional-argument
  "INP001",  # flake8-implicit-namespace-package > implicit-namespace-package
  "PLR0913",  # Pylint Refactor > too-many-arguments
  "PLR2004",  # Pylint Refactor > magic-value-comparison
  "S101",  # flake8-bandit > assert
  "SLF001",  # flake8-self > private-member-access
]
{% if framework == "dagster" %}

# A definitions.py holds the code location entry point and nothing else, so both the module and its `defs()` would be documenting the same one fact.
"**/definitions.py" = [
  "D100",  # pydocstyle > undocumented-public-module
  "D103",  # pydocstyle > undocumented-public-function
]
# Asset, op and sensor modules.
"**/defs/**" = [
  "PLR0913",  # Pylint Refactor > too-many-arguments
  "INP001",  # flake8-implicit-namespace-package > implicit-namespace-package
]

[lint.pep8-naming]
classmethod-decorators = ["dataframely.rule"]

# These read an annotation at runtime, so TC00x must leave their imports outside TYPE_CHECKING.
[lint.flake8-type-checking]
runtime-evaluated-base-classes = [
  "dagster.Config",
  "dagster.ConfigurableResource",
  "dagster.ConfigurableIOManager",
  "pydantic.BaseModel",
]
runtime-evaluated-decorators = [
  "dagster.asset",
  "dagster.multi_asset",
  "dagster.graph_asset",
  "dagster.op",
  "dagster.asset_check",
]
{% elif framework == "fastapi" %}

# Pydantic and FastAPI read an annotation at runtime, so TC00x must leave their imports outside TYPE_CHECKING.
[lint.flake8-type-checking]
runtime-evaluated-base-classes = ["pydantic.BaseModel"]
{% endif %}

[lint.pydocstyle]
convention = "numpy"

[format]
docstring-code-format = true
line-ending = "lf"
